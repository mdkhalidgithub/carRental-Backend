# =========================================================================
# MongoDB Configuration
# =========================================================================
# The MongoDB Atlas connection string (or local fallback for local development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/carRent?retryWrites=true&w=majority

# =========================================================================
# JWT Configuration
# =========================================================================
# Secret key used for signing and verifying JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here

# =========================================================================
# Email Configuration (Nodemailer / Gmail)
# =========================================================================
# Gmail account address to send automatic confirmations
EMAIL_USER=your_gmail@gmail.com
# Google App Password (not your primary password)
EMAIL_PASSWORD=your_gmail_app_password
# Admin inbox email address to receive registration/booking notifications
ADMIN_EMAIL=your_gmail@gmail.com

# =========================================================================
# Server Configuration
# =========================================================================
# Development port number (Vercel sets this dynamically)
PORT=5000
NODE_ENV=development
